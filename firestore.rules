rules_version = '2';
// Client access only. The API uses the Admin SDK, which bypasses these rules,
// so every status change goes through the API and its shared business rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isManager() {
      return signedIn() && request.auth.token.role == "manager";
    }
    function isFinance() {
      return request.auth != null && request.auth.token.finance == true;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow write: if false; // admin tooling only
    }

    match /expenses/{id} {
      // An employee creates their own draft. Server-owned fields
      // (amountBase, fxRate, approvedBy, spotCheck...) can't be sent.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "draft"
        && request.resource.data.keys().hasOnly([
             "ownerId", "amount", "currency", "category", "spentOn",
             "note", "receiptPath", "status"])
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.currency is string
        && request.resource.data.currency.size() == 3;
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid
            || request.auth.token.role == "manager"
            || (isFinance() && resource.data.status == "awaiting_finance"));
      allow update, delete: if false; // edits and approvals go through the API

      // The audit trail: one record per approval step.
      match /approvals/{step} {
        allow read: if request.auth != null
          && (request.auth.token.role == "manager" || isFinance());
        allow write: if false; // server-only, append-only
      }
    }

    // Approval settings: everyone signed in may read them (the UI explains the
    // threshold); changes go through the admin route, which records who and when.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Server-only collections. The Admin SDK bypasses rules; clients get nothing.
    match /partnerKeys/{hash} {
      allow read, write: if false;
    }
    match /idempotency/{key} {
      allow read, write: if false;
    }
    match /notifications/{id} {
      allow read, write: if false;
    }
    // Exchange rates cached by the API (services/fx-rates.ts).
    match /fxRates/{id} {
      allow read, write: if false;
    }
  }
}
