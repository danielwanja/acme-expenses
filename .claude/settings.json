{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)", "Bash(npm run typecheck)", "Bash(npm run lint)",
      "Bash(npm run test:emu)", "Bash(npm run test:e2e)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git commit *)",
      "WebFetch(domain:docs.rates.example)",
      "mcp__acme-approvals__approvals_list_pending"
    ],
    "ask": ["Bash(git push *)", "Bash(npm install *)", "mcp__firebase"],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./apps/api/.secret.local)",
      "Bash(firebase deploy *)", "mcp__firebase__firebase_deploy",
      "Edit(/legacy/**)"
    ]
  },
  "hooks": {
    "SessionStart": [{
      "matcher": "compact",
      "hooks": [{ "type": "command", "command":
        "cat \"$CLAUDE_PROJECT_DIR\"/PROGRESS.md 2>/dev/null || true" }]
    }],
    "Stop": [{
      "hooks": [
        { "type": "command", "command": "npm test --silent 1>&2 || exit 2" }
      ]
    }],
    "PreToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
        "onFailure": "block"
      }]
    }, {
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lock-tests.sh"
      }]
    }]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  }
}
